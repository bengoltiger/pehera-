# PEHRA configuration example.
#
# Copy to `backend/.env` and edit. Every key is optional — the defaults in
# `backend/app/core/config.py` run the full demo out of the box. All backend
# settings use the PEHRA_ prefix.
#
#   cp .env.example backend/.env

# ----------------------------------------------------------- application ----
PEHRA_ENVIRONMENT=development
PEHRA_DEBUG=true

# ---------------------------------------------------------- data honesty ----
# TRUE  = every environmental value is deterministic simulation (the only
#         supported mode today; the UI says so on every screen).
# FALSE = expects real provider adapters to be registered. None ship with the
#         prototype, so leave this true unless you have written your own.
PEHRA_DEMO_MODE=true
PEHRA_DATA_MODE_LABEL=DEMO / SIMULATED DATA

# -------------------------------------------------------------- database ----
# SQLite by default. Any SQLAlchemy URL works, e.g.
# postgresql+psycopg://pehra:pehra@localhost:5432/pehra
PEHRA_DATABASE_URL=sqlite:///./pehra.db

# -------------------------------------------------------------- security ----
# MUST be set to a long random value outside development. The app reports an
# insecure default at /api/system-status instead of hiding it.
PEHRA_JWT_SECRET=dev-only-insecure-secret-change-me
PEHRA_ACCESS_TOKEN_TTL_MINUTES=720

PEHRA_RATE_LIMIT_ENABLED=true
PEHRA_RATE_LIMIT_REQUESTS=240
PEHRA_RATE_LIMIT_WINDOW_SECONDS=60
PEHRA_RATE_LIMIT_WRITE_REQUESTS=40

# ------------------------------------------------------------- providers ----
# Adapter slots. "demo" is the only implementation included; the registry is
# where a real IMD / CWC / satellite adapter would be plugged in.
PEHRA_WEATHER_PROVIDER=demo
PEHRA_RAINFALL_PROVIDER=demo
PEHRA_RIVER_PROVIDER=demo
PEHRA_SATELLITE_PROVIDER=demo
PEHRA_TERRAIN_PROVIDER=demo
PEHRA_HISTORICAL_PROVIDER=demo

# ---------------------------------------------------------- notifications ----
# No real gateway is configured. Leave these empty: every delivery is recorded
# as "SIMULATED DELIVERY" and nothing leaves the machine.
PEHRA_NOTIFICATION_PUSH_ENABLED=true
PEHRA_NOTIFICATION_SMS_ENABLED=true
PEHRA_NOTIFICATION_EMAIL_ENABLED=true
PEHRA_NOTIFICATION_INAPP_ENABLED=true
# PEHRA_SMS_GATEWAY_URL=
# PEHRA_SMTP_HOST=

# ----------------------------------------------------------- risk models ----
# demo | statistical | ml   (swappable at runtime from the simulation lab)
PEHRA_ACTIVE_RISK_MODEL=demo
# PEHRA_ML_MODEL_PATH=app/riskmodels/artefacts/nowcaster.pkl

# ------------------------------------------------------------------- map ----
PEHRA_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PEHRA_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ------------------------------------------------------------------ CORS ----
# Not needed when FastAPI serves the built SPA on the same origin.
PEHRA_CORS_ORIGINS=["*"]


# ============================================================== frontend ====
# Vite variables live in `frontend/.env`. Leave VITE_API_BASE empty for the
# normal single-origin setup (dev proxy, or FastAPI serving backend/static).
# Set it only when the API runs on a different origin.
# VITE_API_BASE=http://127.0.0.1:8000
